{
  "branches": [
    {
      "name": "dev",
      "prerelease": true
    },
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "semantic-release-pano",
      {
        "resourceId": "YOUR_RESOURCE_ID",
        "file": "build/libs/pano-plugin-announcement-${version}.jar",
        "panoVersion": "1.0.0"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "build/libs/*.jar",
            "label": false
          },
          {
            "path": "LICENSE",
            "label": false
          }
        ]
      }
    ]
  ],
  "repositoryUrl": "https://github.com/PanoMC/pano-plugin-announcement.git"
}